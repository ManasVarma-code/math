{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "preinstall": "node scripts/check-package-manager.cjs",
    "build": "pnpm run typecheck && pnpm --filter @workspace/equationpath run build",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck",
    "dev": "pnpm --filter @workspace/equationpath run dev",
    "preview": "pnpm --filter @workspace/equationpath run serve",
    "test": "pnpm --filter @workspace/equationpath run test",
    "test:e2e": "pnpm --filter @workspace/equationpath run test:e2e"
  },
  "private": true,
  "dependencies": {
    "@replit/connectors-sdk": "^0.4.3"
  },
  "devDependencies": {
    "prettier": "^3.9.10",
    "typescript": "~5.9.3"
  },
  "packageManager": "pnpm@11.25.0"
}
